# Local development template only. Replace placeholders before any shared deployment.
# Copy to .env and fill in values when running locally.

# Local authentication (the example signing secret is not suitable outside local development)
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_MINUTES=30
BOOTSTRAP_TENANT_NAME=Local workspace
BOOTSTRAP_TENANT_SLUG=local
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Job delivery (local remains the default)
JOB_TRANSPORT=local
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=document-processing
RQ_JOB_TIMEOUT_SECONDS=900

# Direct local execution can use SQLite; Compose and vector integration use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Object storage (local remains the default)
STORAGE_BACKEND=local
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_BYTES=20971520  # 20MB

# S3-compatible storage (required only when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
