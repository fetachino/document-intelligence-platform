# Example environment variables for local development
# Copy to .env and fill in values when running locally

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# Job delivery (local remains the default)
JOB_TRANSPORT=local
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=document-processing
RQ_JOB_TIMEOUT_SECONDS=900

# Database
# Use postgres for production: postgresql+asyncpg://user:pass@db:5432/docdb
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Object storage (local remains the default)
STORAGE_BACKEND=local
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_BYTES=20971520  # 20MB

# S3-compatible storage (required only when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# OpenAI (not used in Milestone 1)
OPENAI_API_KEY=

# Rate limiting
AI_RATE_LIMIT_PER_MINUTE=30
